# Anthropic API key — powers the AI analyst panel.
# Get one at https://console.anthropic.com/settings/keys
#
# Local dev:  copy this file to `.env.local` and paste your key below.
# Vercel:     add ANTHROPIC_API_KEY under Project Settings -> Environment Variables.
#
# This is read only on the server (app/api/insights/route.ts). It is never sent
# to the browser. Do not prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Overrides the model used by the AI analyst.
# ANTHROPIC_MODEL=claude-opus-5
